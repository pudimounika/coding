public class Solution {
       public static boolean PerfectNumber(int n){
         int sum = 1;
         for(int i=2;i*i<=n;i++){
            if(n%i == 0){
                sum = sum + i;
                if(i != n/i){
                    sum = sum + n/i;
                }
            }
       }
        if(sum == n){
           return true;
        }
         return false;
       }
