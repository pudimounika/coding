2nd Pattern

import java.util.Scanner;
public class Solution {
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        for(int i=1;i<=n;i++){
            for(int j=1;j<=i;j++) {
                System.out.print("*"+" ");
            }
            System.out.println();
        }
    }
}
Python Code : 
n = int(input())
for i in range(1,n+1): 
    for j in range(1,i+1):
        print("*",end=" ")
    print()
