import java.util.Scanner;

public class Solution {
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int size = 2*n-1;
        for(int i=0;i<size;i++){
            for(int j=0;j<size;j++){
               int left = j-0;
               int right = ((size -1)-j);
               int top = i-0;
               int bottom = ((size -1)-i);
               int d = Math.min(
                   Math.min(left,right) ,
                   Math.min(top,bottom)  
               );
               int value = n-d;
               System.out.print(value + " ");
    }
    System.out.println();
}}}

